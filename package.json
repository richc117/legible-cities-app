{
  "name": "legible-cities-app",
  "productName": "Legible Cities",
  "version": "1.0.0",
  "description": "A desktop app for Legible Cities: schematic transit maps and animations from a GTFS feed, for people who do not use a terminal.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0 && prettier --check \"src/**\" \"tests/**\" \"scripts/**/*.ts\" \"*.{ts,mts,js,mjs,json}\"",
    "format": "prettier --write \"src/**\" \"tests/**\" \"scripts/**/*.ts\" \"*.{ts,mts,js,mjs,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.tests.json --composite false",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "dist": "electron-builder --dir",
    "dist:check": "node scripts/check-vendored.mjs",
    "typegen": "node --experimental-strip-types scripts/protocol.ts",
    "test:acceptance": "playwright test -c playwright.acceptance.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rogieking/figui3": "11.6.7",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
