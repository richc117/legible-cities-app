{
  "name": "legible-cities-app",
  "productName": "Legible Cities",
  "version": "0.0.0",
  "description": "A desktop app for Legible Cities: schematic transit maps and animations from a GTFS feed, for people who do not use a terminal.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && prettier --check \"src/**\" \"tests/**\" \"scripts/**/*.ts\" \"*.{ts,mts,js,mjs,json}\"",
    "format": "prettier --write \"src/**\" \"tests/**\" \"scripts/**/*.ts\" \"*.{ts,mts,js,mjs,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.tests.json --composite false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-builder --dir",
    "typegen": "node --experimental-strip-types scripts/protocol.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rogieking/figui3": "9.0.0",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "react-colorful": "5.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
