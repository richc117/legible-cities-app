    "commit": "8c521a1815759a64b46a5f876dd84b1d8b0878d4",
    "note": "MSYS2/UCRT64 build scripts and compatibility patches for Windows.",
    "licence": "GPL-3.0"
  },
  "engine": {
    "repo": "https://github.com/richc117/legible-cities",
    "tag": "v0.8.3",
    "version": "0.8.3",
    "protocol": 1,
    "note": "The same bytes on every machine. At v0.8.3 every text file the engine reads or writes is UTF-8 with LF, the service day is formatted without %-d or the locale's names, and --schema writes its bytes past the console's text layer, so a Windows sidecar can build a map, plan an export and print the schema the fingerprint below was taken from (E19; engine issue 22). Before it, v0.8.2 made map.build's line_order a preference rather than a whitelist (A4-02, engine issue 28). Additive at protocol 1 and the schema is byte-identical, so the tag is the gate. The handshake compares version and protocol with engine.info and refuses any other; the vendoring job installs the package at the tag.",
    "licence": "GPL-3.0-or-later",
    "schema_sha256": "908af7aba329a3e8ff42c7e9ebbd898d8efc3aaeffd1e7a68f3df3b622d55067"
  },
