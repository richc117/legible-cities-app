# Copy to .env.local (gitignored) for development. Every key is optional;
# the app starts with the defaults below and logs what is unset. Read in
# development only; a packaged build reads the process environment. Values
# in the process environment override this file. See
# specs/001-electron-skeleton/contracts/config.md.

# The engine's home: feeds/, graphs/, projects/, out/, logs/ live under it.
# Default: the "engine" folder under the app's user-data directory.
#SCHEMATIC_HOME=

# Directory holding the four LOOM tools: gtfs2graph, topo, loom, octi.
# Passed to the engine as is; nothing reads it until the engine's native
# backend exists (it runs LOOM in Docker until then).
#SCHEMATIC_LOOM_BIN=

# Path to the ffmpeg executable. Passed to the engine as is.
#SCHEMATIC_FFMPEG=

# Where exports are written, in a folder per project. Unset: a "Legible Cities"
# folder on the desktop, until Settings (A1-04) offer a chooser.
# LEGIBLE_EXPORT_FOLDER=

# The engine's source checkout, for the development loop: the tokens drift
# test reads the animation page from it, and the engine runs from its own
# virtual environment (<checkout>/.venv). Usually the sibling directory.
#LEGIBLE_ENGINE_CHECKOUT=../legible-cities

# An interpreter to run the engine with, instead of the checkout's
# environment: a path, or a bare command name for PATH to resolve. The app
# never searches PATH on its own. The tests point this at the system Python
# with PYTHONPATH=tests/fake-engine to run the stand-in engine.
#LEGIBLE_ENGINE_PYTHON=
