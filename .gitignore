# Build output and dependencies
node_modules/
dist/
out/
release/
.vite/
coverage/
test-results/
playwright-report/

# Vendored runtimes and binaries are CI artefacts, never committed
vendor/python/
vendor/loom/
vendor/ffmpeg/

# Secrets and signing material (the documented example is tracked)
.env
.env.*
!.env.example
*.p12
*.pem
*.key
*.mobileprovision

# The maintainer's assistant configuration is not part of the repository:
# the checkout reaches it through symbolic links kept out of the tree.
CLAUDE.md
CLAUDE.local.md
.claude/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# The stand-in engine is Python; the Python bytecode cache has no place here.
__pycache__/
*.pyc
