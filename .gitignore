# Build output and dependencies
# No slash: a worktree's node_modules is often a link to another checkout's,
# and `node_modules/` matches only a directory, so the link was committed.
node_modules
# The same for what a build writes, which a worktree can link as well:
# `out` is electron-vite's and `release` is electron-builder's. Nothing here
# writes `dist`; it stays ignored for a tool that would.
# Anchored to the top, where they are made: a bare `out` would ignore any
# file or folder of that name anywhere in the tree.
/dist
/out
/release
.vite/
coverage/
test-results/
# The acceptance run's record and screenshots (tests/acceptance, A6-04).
acceptance-results/
playwright-report/

# Vendored runtimes and binaries are CI artefacts, never committed
vendor/python/
vendor/loom/
vendor/ffmpeg/
# ...and the manifest scripts/check-vendored.mjs writes from them for a build.
vendor/manifest-*.json

# Secrets and signing material (the documented example is tracked)
.env
.env.*
!.env.example
*.p12
*.pem
*.key
*.mobileprovision

# The assistant's configuration is committed (ADR-029); only what is
# personal to one machine stays out: private notes and per-machine
# permission overrides.
CLAUDE.local.md
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# The stand-in engine is Python; the Python bytecode cache has no place here.
__pycache__/
*.pyc

# Scratch probes. bin/preflight reads the index, not the working tree, so a
# stray file here would be invisible to it until the moment it was staged.
*.tmp.*
probe*.mjs
