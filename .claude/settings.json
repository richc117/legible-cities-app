{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(bin/preflight*)",
      "Bash(gitleaks dir*)",
      "Bash(gitleaks git*)",
      "Bash(pre-commit run)",
      "Bash(pre-commit run --all-files)",
      "Bash(pre-commit validate-config*)"
    ],
    "deny": [
      "Bash(git difftool*)",
      "Bash(git mergetool*)",
      "Read(./.env*)",
      "Read(./.git/config)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.mobileprovision)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
