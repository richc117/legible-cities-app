#!/usr/bin/env bash
# Refuse to let personal paths, addresses, keys or tool-session links into a
# public repository. Three passes: the index (everything that would be
# committed), every commit message in the history, and private files that
# have strayed into the working tree. Exit 1 on any hit. Run before every
# push; the pull request template asks for it.
#
#   bin/preflight                     the three passes above
#   bin/preflight --message-file FILE scan a commit message being written
#
# The second form is what the `commit-msg` hook in .pre-commit-config.yaml
# runs, so a bad trailer is refused while it can still be edited rather than
# after it is history. gitleaks is the other half of the pair: it knows keys
# and tokens, this knows the rest of the never list.
set -u
usage() { echo "usage: preflight [--message-file FILE]" >&2; exit 2; }
msgfile=''
while [ $# -gt 0 ]; do
  case "$1" in
    --message-file) [ $# -ge 2 ] || usage; msgfile=$2; shift 2 ;;
    -h|--help) usage ;;
    *) echo "preflight: unknown argument: $1" >&2; usage ;;
  esac
done
cd "$(git rev-parse --show-toplevel)" || exit 1
pattern='/Users/[A-Za-z]|/home/[A-Za-z0-9._-]+|[A-Za-z]:[\\/]{1,2}[Uu]sers[\\/]|@gmail\.com|@icloud\.com|@outlook\.com|100\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|10\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+|\.ts\.net\b|fd7a:115c:a1e0:|ghp_[A-Za-z0-9]{20,}|github_pat_|-----BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|claude\.ai/code/|Claude-Session:'
status=0

if [ -n "$msgfile" ]; then
  # 0. A commit message being written, read from the file git is about to
  #    use. One file, so grep prints line numbers without a path prefix.
  found=$(grep -nE "$pattern" -- "$msgfile" || true)
  if [ -n "$found" ]; then
    echo "preflight: this commit message contains something that must not be public:" >&2
    echo "$found" >&2
    echo "preflight: edit the message; nothing has been committed." >&2
    exit 1
  fi
  echo "preflight: commit message clean"
  exit 0
fi

# 1. The index: tracked files plus staged changes, real path:line output.
hits=$(git grep --cached -nE "$pattern" -- . ':(exclude)bin/preflight' 2>/dev/null || true)
if [ -n "$hits" ]; then
  echo "preflight: files about to be committed contain something that must not be public:" >&2
  echo "$hits" >&2; status=1
fi

# 2. Commit message bodies, all of them; author metadata is not scanned.
#    Not the range against the tracked upstream: that describes the branch,
#    not the remote a push is going to, so with a second remote it can be
#    empty for a push that sends the whole history somewhere new. CI scans
#    everything for the same reason; this way the answer is the same here.
if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  msgs=$(git log --format='%h %B' HEAD 2>/dev/null | grep -nE "$pattern" || true)
  if [ -n "$msgs" ]; then
    echo "preflight: an unpushed commit message contains something that must not be public:" >&2
    echo "$msgs" >&2; status=1
  fi
fi

# 3. Private files present and not ignored.
# .env.example is the documented, tracked example with no real value in it;
# every other .env* file is private.
stray=$(git status --porcelain 2>/dev/null | grep -E 'CLAUDE\.local\.md|settings\.local\.json|\.env|\.p12|\.pem|\.key$' | grep -vE '(^|[ /])\.env\.example$' || true)
if [ -n "$stray" ]; then
  echo "preflight: a private file is in the working tree and not ignored:" >&2
  echo "$stray" >&2; status=1
fi

[ $status -eq 0 ] && echo "preflight: clean"
exit $status
